# Template for .env. Run scripts/setup-env.sh: it creates .env with random secrets, or adds
# keys that an older .env is missing. .env holds secrets and is not committed.

# Docker Compose uses this to create the database user.
POSTGRES_PASSWORD=CHANGE_ME

# Npgsql connection string for sb and the hub. Single quotes because the scripts load this
# file into bash, where ";" would end the line.
SWITCHBOARD_DB='Host=localhost;Port=5433;Database=switchboard;Username=switchboard;Password=CHANGE_ME'

# Where the hub listens. Loopback only until phase 5.
SWITCHBOARD_HUB_URL=http://127.0.0.1:7700

# The owner's API token (curl, scripts/start-manager.sh). Treat it like a password.
SWITCHBOARD_ADMIN_TOKEN=CHANGE_ME_TOKEN

# Optional. The hub keeps a manager session running (ManagerSupervisor). Defaults shown.
# SWITCHBOARD_MANAGER_AUTOSTART=true
# SWITCHBOARD_MANAGER_DIR=/home/you/.switchboard/manager   # must survive reboots (not /tmp)
# SWITCHBOARD_MANAGER_FRESH_HOURS=24                        # fresh conversation after this
# SWITCHBOARD_MANAGER_BACKOFF=0,10,60,300                   # seconds before restart 1, 2, 3, 4
