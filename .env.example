# Template for .env. Run scripts/setup-env.sh to copy it with a random password.
# .env holds secrets and is not committed.

# Docker Compose uses this to create the database user.
POSTGRES_PASSWORD=CHANGE_ME

# Npgsql connection string for sb (and later the hub). Single quotes because the ./sb script
# loads this file into bash, where ";" would end the line.
SWITCHBOARD_DB='Host=localhost;Port=5433;Database=switchboard;Username=switchboard;Password=CHANGE_ME'
