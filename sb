#!/usr/bin/env bash
# Runs the Switchboard CLI from source. `dotnet run` rebuilds first if the code changed.
# Usage: ./sb <command> [args...]   (run ./sb with no arguments for help)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Load SWITCHBOARD_DB and friends from .env. `set -a` exports every variable it defines.
if [[ -f "$here/.env" ]]; then
  set -a
  source "$here/.env"
  set +a
fi

exec dotnet run --project "$here/src/Switchboard.Cli" --verbosity quiet -- "$@"
